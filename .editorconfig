# Gaya dasar berkas — dibaca otomatis oleh VS Code, JetBrains, dll.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Seed data dibangkitkan alat — jangan diformat ulang
[src/1[0-8]_Seed*.gs]
trim_trailing_whitespace = false
insert_final_newline = false
